# ─────────────────────────────────────────────────────────
# Grace Muigai Music Academy — Environment Variables
#
# This file is a TEMPLATE ONLY — never put real values here, since it's
# committed to Git. Copy it to .env.local (already gitignored) and fill in
# real values there, then add the same keys in Vercel → Project → Settings
# → Environment Variables for the live site.
# ─────────────────────────────────────────────────────────

# Firebase (Client SDK) — get these from Firebase Console → Project settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloudinary (free image uploads — used instead of Firebase Storage, which
# requires the paid Blaze plan to enable). Sign up free at cloudinary.com,
# then Settings → Upload → Add upload preset → Signing Mode: Unsigned.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Site
NEXT_PUBLIC_SITE_URL=https://tutor-grace.vercel.app
NEXT_PUBLIC_SITE_NAME="Grace Muigai Music Academy"

# Contact / WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=254702337575
NEXT_PUBLIC_PHONE_PRIMARY=0702337575
NEXT_PUBLIC_PHONE_SECONDARY=0735886920
NEXT_PUBLIC_CONTACT_EMAIL=cbc.grace76@gmail.com

# M-Pesa (manual payment display — shown on the payment page)
# Confirmed by the client: Buy Goods Till 4349699 (business name: Grace).
NEXT_PUBLIC_MPESA_TILL_NUMBER=4349699
NEXT_PUBLIC_MPESA_BUSINESS_NAME="Grace"

# M-Pesa STK Push (optional — instant payment prompts via Safaricom Daraja)
# Leave NEXT_PUBLIC_MPESA_STK_ENABLED unset/false until all MPESA_* vars
# below are filled in and tested in sandbox. See lib/mpesa.ts for setup.
NEXT_PUBLIC_MPESA_STK_ENABLED=false
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# Optional override. Defaults: sandbox = CustomerPayBillOnline, production = CustomerBuyGoodsOnline
# MPESA_TRANSACTION_TYPE=

# Firebase Admin SDK (server-only — powers the admin portal, STK Push
# lookups, and the M-Pesa callback webhook). Get these from Firebase
# Console → Project settings → Service accounts → Generate new private key.
# Paste the whole "private_key" value from the downloaded JSON, quotes and
# all — Next.js will keep the \n sequences intact.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Email notifications via Resend (free tier, resend.com). Grace is emailed when a
# student registers, a payment arrives, or someone uses the contact form.
# Leave RESEND_API_KEY blank to switch notifications off; nothing else breaks.
RESEND_API_KEY=
NOTIFICATION_EMAIL=cbc.grace76@gmail.com
NOTIFICATION_FROM_EMAIL="Grace Muigai Music Academy <onboarding@resend.dev>"
